# Shared local development defaults
NODE_ENV=development
APP_BASE_URL=http://localhost:5173

# Stripe local testing
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Supabase local/dev
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Local placeholder persistence for Stripe/webhook/lead records
PLACEHOLDER_DATA_DIR=.local-data

# Paperclip -> Make relay (optional)
PAPERCLIP_API_BASE=http://127.0.0.1:3101/api
PAPERCLIP_COMPANY_ID=replace_me
PAPERCLIP_API_KEY=replace_me
MAKE_WEBHOOK_URL=https://hook.us2.make.com/replace_me
MAKE_WEBHOOK_API_KEY=replace_me
PAPERCLIP_APPROVER_USER_ID=local-board
PAPERCLIP_UI_BASE=http://127.0.0.1:3100
PAPERCLIP_RELAY_STATE_PATH=./scripts/paperclip_to_make.state.json

# Paperclip relay reliability tuning (optional)
PAPERCLIP_DRAIN_BATCH_LIMIT=50
PAPERCLIP_MIN_DISPATCH_INTERVAL_MS=250
PAPERCLIP_MAX_QUEUE_SIZE=2000
PAPERCLIP_CIRCUIT_FAILURE_THRESHOLD=5
PAPERCLIP_CIRCUIT_COOLDOWN_SEC=120
